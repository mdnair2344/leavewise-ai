# Copy to .env for local dev. On Vercel, add the same names under Project -> Settings -> Environment Variables.
# NEVER commit real keys.

# ---- AI (pick ONE provider; with no key the app still works using built-in template text) ----
# Free option: Google AI Studio key  ->  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Or Anthropic:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Or any OpenAI-compatible API (OpenAI, Groq, OpenRouter...):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# Force a provider when several keys are set: gemini | anthropic | openai
# LLM_PROVIDER=

# ---- Database (optional; saved commutes sync across devices) ----
# MongoDB Atlas connection string  (mongodb+srv://USER:PASSWORD@cluster.mongodb.net/)
MONGODB_URI=
# MONGODB_DB=leavewise

# ---- Misc ----
# Max AI requests per IP per 10 minutes (per serverless instance)
# AI_RATE_LIMIT=40


# ---- Accounts (needs MONGODB_URI above) ----
# Any long random string, 16+ characters. Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, login is hidden and everyone uses guest mode.
AUTH_SECRET=